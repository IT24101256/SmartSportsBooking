# =============================================================================
# MySpot / SmartSports Booking - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS FOR ALL PLATFORMS (Windows, macOS, Linux):
# 1. Copy this file to '.env' in either the repository root or backend/SmartSports.Api/.
#    Example command (Terminal / PowerShell / Bash):
#      cp .env.example .env
# 2. Fill in your own local credentials below.
# 3. DO NOT commit '.env' to Git. Keep real passwords and API keys private.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Server Settings
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT="Development"
ASPNETCORE_URLS="http://0.0.0.0:5187"

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Adjust the username and password to match YOUR local PostgreSQL server.
# Windows typical default:  Username=postgres;Password=your_password
# Mac Homebrew typical:     Username=postgres;Password=your_password  (or your Mac username)
SMARTSPORTS_DB_CONNECTION="Host=localhost;Port=5432;Database=SmartSportsBookingDb;Username=postgres;Password=your_password"

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Must be at least 32 characters long.
JWT_KEY="replace-with-a-random-secret-at-least-32-characters"
JWT_ISSUER="SmartSports.Api"
JWT_AUDIENCE="SmartSports.Client"

# -----------------------------------------------------------------------------
# Email / SMTP Configuration (Registration OTP & Password Reset)
# -----------------------------------------------------------------------------
# Option A: Real Email with Resend API (RECOMMENDED FOR RENDER CLOUD HOSTING)
# Render Free tier blocks outbound SMTP ports 25, 465, and 587. Resend sends over HTTPS (port 443).
# Get a free key (3,000 emails/month free): https://resend.com
RESEND_API_KEY=""

# Option B: Real Email with Gmail SMTP (for local development or Render paid plans)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
#    - Select app: 'Other (custom name)', type 'MySpot', click Generate.
# 3. Paste the 16-character password into SMTP_PASSWORD (spaces are automatically removed).
# 4. Set SMTP_FROM and SMTP_USER to your full Gmail address.
#
# Option C: Local Testing Without Email
# - Leave SMTP_FROM and SMTP_PASSWORD empty ("").
# - In Development mode, the API will display verification codes (devOtp) directly
#   in the browser/app and API console so you can test registration instantly.
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_FROM=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="MySpot Sports"

# Set to 'true' to strictly enforce real email delivery (returns 503 if email fails).
# Set to 'false' during development so devOtp is generated if offline or SMTP is unconfigured.
REQUIRE_REAL_EMAIL=false

# In production, set to 'true' if you want verification codes returned in API response as fallback
ALLOW_DEV_OTP_FALLBACK=false

# Bypass SSL certificate errors on macOS / Linux / corporate proxies
SMTP_IGNORE_CERT_ERRORS=false

# -----------------------------------------------------------------------------
# Google Gemini AI Integration (Grounded Assistant & Book With AI)
# -----------------------------------------------------------------------------
# Get a free Gemini API key: https://aistudio.google.com/
# If left empty, the application runs in deterministic offline AI agent mode.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Production mock-card test payment (not real payment processing)
AI_ENABLE_MOCK_CARD_PAYMENTS=false
AI_MOCK_CARD_NUMBER=""
AI_MOCK_CARD_CVV=""

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# -----------------------------------------------------------------------------
# Frontend Client Configuration (Vite React Web App)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:5187/api"
